{
  "name": "teadesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write .",
    "sb:config": "dotenvx run -f supabase/.env -fk .env.keys -- supabase config push",
    "sb:secrets": "dotenvx decrypt -f supabase/functions/.env -fk .env.keys --stdout | supabase secrets set --env-file /dev/stdin",
    "sb:env": "npm run sb:config && npm run sb:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
